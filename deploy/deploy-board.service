# 공유용 보기 전용 보드(systemd 사용자 서비스). 설치는 README 「공유 서버」 절.
# 수집·새로고침·swap 이 없고, 수집 PC 가 --publish 로 올려 준 data/state.json 만 보여 준다.
[Unit]
Description=deploy-board (readonly share)
After=network-online.target

[Service]
WorkingDirectory=%h/deploy-board
ExecStart=/usr/bin/python3 server.py --readonly --port 8790 --bind 0.0.0.0
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
